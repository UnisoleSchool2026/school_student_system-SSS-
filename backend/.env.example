# ==============================================================================
# HAPS-AI SCHOLAR ASSISTANT: ENVIRONMENT CONFIGURATION
# Him Academy Public School (HAPS), Hamirpur
# ==============================================================================

# Server Port
PORT=5050
NODE_ENV=development

# Decoupled Frontend Origins (for CORS)
FRONTEND_URL=http://localhost:3008
CORS_ORIGIN=http://localhost:3008,http://127.0.0.1:3008,http://localhost:3000

# LLM Providers (Provide your API keys here)
# Get Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get Groq API Key: https://console.groq.com/keys
GROQ_API_KEY=

# PostgreSQL Database
DATABASE_URL=postgres://haps_admin:haps_secure_password_2026@localhost:5432/haps_scholar_db

# Apache Kafka Event Streaming Bus
KAFKA_BROKERS=localhost:9092

# JWT Signing Secret (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-random-32-byte-hex-jwt-secret-here

# Optional WhatsApp Parental Notification Gateway (Meta Cloud API / Twilio)
WHATSAPP_API_TOKEN=
TWILIO_ACCOUNT_SID=

# Multi-Tenant School Profile (src/registry/tenants/<schoolId>.json)
# Resolution order per request: x-school-id header > ?schoolId= > Host subdomain > DEFAULT_SCHOOL_ID > sch_unisole_001
DEFAULT_SCHOOL_ID=sch_unisole_001

# ==============================================================================
# PRODUCTION SETTINGS (added 2026-11-17)
# ==============================================================================

# PostgreSQL persistence (src/services/persistence.js). All school data (tests,
# submissions, DPPs, doubts, notices, mistake notebook, study progress, injected
# questions) is saved to the table `school_records` in DATABASE_URL and loaded
# again when the server starts. Run ONE backend instance per database.
# true  = refuse to start when the database cannot be reached (use in production)
# false = start anyway and keep data in memory only (data is lost on restart)
DATABASE_REQUIRED=false
# TLS for the database connection. `sslmode=` inside DATABASE_URL wins; otherwise
# this flag; otherwise TLS is on when NODE_ENV=production.
# DATABASE_SSL=true
# Separate, empty database used only by `npm run test:postgres` (it drops the table).
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/unisole_test

# Kafka is optional. Leave false unless a broker is running at KAFKA_BROKERS.
KAFKA_ENABLED=false

# Request limits per IP address per minute (src/middleware/security.js)
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AI_PER_MINUTE=40
# RATE_LIMIT_DISABLED=true
# Set to 1 when the server runs behind one reverse proxy (nginx, Render, Railway...)
# so that the real client IP is used for rate limiting.
# TRUST_PROXY=1

# Study Board. With a GEMINI_API_KEY the board can explain a topic in more detail
# and work out a typed or photographed doubt. Without a key (or with false here)
# it uses the syllabus and the school question bank only.
STUDY_BOARD_AI=true
# GEMINI_MODEL=gemini-2.5-flash

# Gemini models are found automatically (ListModels) and the best available one is used.
# Pin them here only if needed:
# GEMINI_VISION_MODEL=gemini-2.5-flash      # reading question-paper photos
# GEMINI_TEXT_MODEL=gemini-2.5-flash        # Study Board lessons and doubts
# Voice teacher on the Study Board (Gemini Live, native audio, human-sounding voice):
# GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest
# GEMINI_LIVE_VOICE_FEMALE=Kore
# GEMINI_LIVE_VOICE_MALE=Charon
# Testing only (offline mock, see scripts/mock_gemini_server.js):
# GEMINI_API_BASE=http://127.0.0.1:8787
# GEMINI_LIVE_WS_BASE=ws://127.0.0.1:8787
# Where runtime data files are written (default: backend/data)
# DATA_DIR=
