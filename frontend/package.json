{
  "name": "haps-ai-scholar-frontend",
  "version": "1.0.0",
  "description": "Standalone Frontend Web Portal for HAPS-AI Scholar Assistant",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:whiteboard": "esbuild src_whiteboard/index.jsx --bundle --minify --format=iife --target=es2020 --outfile=vendor/tldraw/tldraw-standalone.bundle.js --define:process.env.NODE_ENV='\"production\"'",
    "build": "npm run build:whiteboard && echo 'Frontend build complete'",
    "test": "node scripts/test_intuitive_solution_card.js && node scripts/test_buttons.js",
    "test:buttons": "node scripts/test_buttons.js",
    "test:solution-card": "node scripts/test_intuitive_solution_card.js",
    "test:latex": "node scripts/test_latex_formatter.js && node scripts/test_latex_rendering.js",
    "test:quiz-modal": "node scripts/test_quiz_creation_and_modal_display.js",
    "test:guards": "node scripts/test_static_guards.js",
    "test:overflow": "node scripts/test_overflow_viewports.js"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

