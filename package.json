{
  "name": "haps-ai-scholar-assistant",
  "version": "1.0.0",
  "description": "HAPS-AI Scholar Assistant - Enterprise Classroom Intelligence & Diagnostic Engine",
  "main": "api/index.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "node scripts/test_evaluator.js",
    "build:whiteboard": "esbuild frontend/src_whiteboard/index.jsx --bundle --minify --format=iife --target=es2020 --outfile=frontend/vendor/tldraw/tldraw-standalone.bundle.js --define:process.env.NODE_ENV='\"production\"'",
    "build": "npm run build:whiteboard && echo 'Build complete: Static frontend and Serverless API ready'",
    "deploy:staging": "./scripts/deploy_vercel.sh --preview",
    "verify:staging": "node scripts/verify_staging.js",
    "promote:production": "./scripts/promote_to_production.sh"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "cors": "^2.8.5",
    "docx": "^9.14.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kafkajs": "^2.2.4",
    "katex": "^0.19.1",
    "msedge-tts": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.1.1",
    "uuid": "^9.0.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
